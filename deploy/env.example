# Copy to ".env" in the project folder on the server and fill in. Never commit or share the real file.

# Major version of PostgreSQL: the same as the Render database (Render dashboard -> the database -> Info), e.g. 16 or 17.
POSTGRES_VERSION=16

# Password of the database (letters and digits only, 20+ characters).
POSTGRES_PASSWORD=doi-mat-khau-nay

# Secret that signs the login cookies: a long random text (openssl rand -hex 32).
# Use the same AUTH_SECRET as on Render if you want everyone to stay logged in; a new one logs everybody out once.
AUTH_SECRET=doi-chuoi-bi-mat-nay

# Domain of the site (e.g. canteen.thcmu.edu.vn). The HTTPS certificate is obtained by itself, the domain must
# already point to this server. Leave ":80" only to test over plain HTTP (then also set COOKIE_SECURE=false).
CADDY_DOMAIN=:80
COOKIE_SECURE=false

# Only for the first start if an officers list has to be imported (same value as on Render). Empty otherwise.
OFFICERS_DATA_B64=
