generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  STUDENT
  OFFICER
  CANTEEN_SUPPORT
  UNION
}

enum MealPattern {
  LUNCH
  DINNER
  BOTH
}

enum MealType {
  LUNCH
  DINNER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id                String   @id @default(cuid())
  phone             String   @unique
  name              String
  passwordHash      String
  role              Role
  mustChangePassword Boolean @default(false)
  active            Boolean  @default(true)
  /// Fixed sequential number for a STUDENT, shown on printed meal lists.
  /// Cleared in bulk by Sales/Manager at the start of each term and
  /// auto-assigned (max existing + 1) when a brand-new student is created.
  orderCode         Int?     @unique
  /// Major ("Ngành") and year ("Lớp": Y1-Y4) of a STUDENT. Informational;
  /// allowed values live in src/lib/student-info.ts.
  major             String?
  className         String?
  /// Fixed staff code ("mã cán bộ", upper case) of an OFFICER, imported with the staff list and never
  /// edited by the officer. It is a second way to log in; `phone` stays the officer's own, editable
  /// number (set equal to the code as a placeholder until they enter one).
  staffCode         String?  @unique
  /// True for every OFFICER, and also for a manager/sales/admin who is an officer too (same login, both
  /// roles). Drives the officer lunch ordering page and the officer groups in lists, reports and stats.
  isOfficer         Boolean  @default(false)
  /// Department ("phòng ban") of an officer, as written in the staff list (e.g. "Phòng TCHCQT").
  department        String?
  /// When true, the officer's lunches Monday to Friday are registered automatically for every week as it
  /// opens (they can still drop days). `autoRegisteredWeek` is the Monday of the last week done this way.
  autoRegister      Boolean  @default(false)
  autoRegisteredWeek DateTime?
  createdAt         DateTime @default(now())

  registrations     MealRegistration[] @relation("StudentRegistrations")
  createdRegistrations MealRegistration[] @relation("CreatedByUser")
  sessions          MealSession[] @relation("StudentSessions")
  logs              ActivityLog[]
  courtBookings     CourtBooking[] @relation("CourtBookings")
  courtDecisions    CourtBooking[] @relation("CourtDecisions")
}

enum CourtBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A court or room that can be booked ("Đặt sân"), with fixed time slots.
model Court {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  slots       CourtSlot[]
  bookings    CourtBooking[]
}

/// One fixed time slot of a court, e.g. 17:00-18:00 ("HH:mm" strings).
model CourtSlot {
  id        String         @id @default(cuid())
  courtId   String
  court     Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startTime String
  endTime   String
  active    Boolean        @default(true)
  bookings  CourtBooking[]

  @@unique([courtId, startTime])
}

/// A booking of one slot on one day. A student's booking waits for the student union (PENDING); other roles are
/// approved at once. The database also holds a partial unique index (slotId, date) over PENDING/APPROVED rows
/// (see the migration), so a slot cannot be double booked.
model CourtBooking {
  id           String             @id @default(cuid())
  courtId      String
  court        Court              @relation(fields: [courtId], references: [id])
  slotId       String
  slot         CourtSlot          @relation(fields: [slotId], references: [id])
  date         DateTime
  userId       String
  user         User               @relation("CourtBookings", fields: [userId], references: [id])
  status       CourtBookingStatus @default(PENDING)
  note         String?
  decidedById  String?
  decidedBy    User?              @relation("CourtDecisions", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([date])
  @@index([userId])
}

/// The "Giá vốn" (Cost Ly) notebook: ingredients, semi-finished products ("batches") and recipes, kept as small
/// JSON documents exactly like the original Cost Ly app stored them. One shared set for the whole canteen.
model CostShop {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  documents CostDocument[]
}

model CostDocument {
  shopId     String
  shop       CostShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collection String
  id         String
  data       Json
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([shopId, collection, id])
}

model MealRegistration {
  id            String       @id @default(cuid())
  studentId     String
  student       User         @relation("StudentRegistrations", fields: [studentId], references: [id])
  startDate     DateTime
  totalSessions Int
  mealPattern   MealPattern
  pricePerMeal  Int
  note          String?
  createdById   String
  createdBy     User         @relation("CreatedByUser", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())

  sessions      MealSession[]
}

model MealSession {
  id             String            @id @default(cuid())
  registrationId String
  registration   MealRegistration  @relation(fields: [registrationId], references: [id])
  studentId      String
  student        User              @relation("StudentSessions", fields: [studentId], references: [id])
  date           DateTime
  mealType       MealType
  status         SessionStatus     @default(SCHEDULED)
  price          Int
  note           String?
  pickedUp       Boolean           @default(false)
  pickedUpAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())

  /// The cancelled session this one was auto-created to compensate for.
  /// Lets a student's cancellation be undone: delete this session and put
  /// the original back to SCHEDULED, instead of leaving them with an extra
  /// meal. Null for the initial sessions of a registration.
  compensationForId String?      @unique
  compensationFor   MealSession? @relation("SessionCompensation", fields: [compensationForId], references: [id])
  compensatedBy     MealSession? @relation("SessionCompensation")

  @@index([studentId, date])
  @@index([registrationId])
}

/// Snapshot of all student data taken by "reset all students" (or right
/// before a restore), so it can be brought back later. `data` holds
/// { users, registrations, sessions } as JSON.
model StudentArchive {
  id           String   @id @default(cuid())
  label        String
  createdAt    DateTime @default(now())
  createdById  String?
  createdByName String
  studentCount Int
  sessionCount Int
  data         Json
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
